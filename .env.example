# Copy to .env (git-ignored, never packaged). Used by the Makefile and tools/ for REST on the management port.
SPLUNK_MGMT_URL=https://127.0.0.1:8090
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
# or, instead of username/password:
SPLUNK_TOKEN=
# Filled in by `make hec-setup`:
HEC_URL=https://localhost:8088
AI_DEMO_HEC_TOKEN=
